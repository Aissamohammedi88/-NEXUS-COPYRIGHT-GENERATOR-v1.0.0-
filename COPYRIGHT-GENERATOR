class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
gz = None
if len(content) > 500 and "gzip" in self.headers.get("Accept-Encoding", ""):
import gzip as gzmod
content = gzmod.compress(content, 6)
gz = "gzip"
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
self.send_header("Access-Control-Allow-Headers", "Content-Type")
if gz:
self.send_header("Content-Encoding", gz)
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, obj, code=200):
self._send(code, json.dumps(obj, ensure_ascii=False, default=str).encode("utf-8"))

def _html(self, html):
self._send(200, html.encode("utf-8"), "text/html")

def do_OPTIONS(self):
self._send(204, b"")

def do_GET(self):
try:
u = urllib.parse.urlparse(self.path)
p = u.path
q = urllib.parse.parse_qs(u.query)

if p in ("/", "/index.html"):
html = HTML.replace("__V__", VERSION).replace("__AUTEUR__", AUTEUR)
return self._html(html)

if p == "/api/health":
return self._json({"status": "ok", "version": VERSION})

if p == "/api/apis":
return self._json({"apis": APIS_COPYRIGHT})

if p == "/api/verify":
nom = q.get("nom", [""])[0]
if not nom:
return self._json({"erreur": "nom requis"}, 400)
return self._json(verifier_paternite(nom))

if p == "/api/licences":
return self._json({"licences": list(LICENCES_PREDEFINIES.keys())})

return self._json({"erreur": "not found"}, 404)
except Exception as e:
return self._json({"erreur": str(e)[:200]}, 500)

def do_POST(self):
try:
u = urllib.parse.urlparse(self.path)
p = u.path
length = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(length).decode("utf-8", "ignore") if length else "{}"
try:
data = json.loads(body)
except Exception:
data = {}

if p == "/api/generate":
licence = data.get("licence", "NEXUS-OPEN-2.0")
auteur = data.get("auteur", AUTEUR)
annee = data.get("annee")
projet = data.get("projet", "")
email = data.get("email", "")
url = data.get("url", "")
result = generer_copyright(licence, auteur, annee, projet, email, url)
return self._json(result)

if p == "/api/header":
auteur = data.get("auteur", AUTEUR)
annee = data.get("annee", datetime.datetime.now().year)
projet = data.get("projet", "")
licence = data.get("licence", "NEXUS-OPEN-2.0")
email = data.get("email", "")
header = generer_header_fichier(auteur, annee, projet, licence, email)
return self._json({"header": header})

return self._json({"erreur": "not found"}, 404)
except Exception as e:
return self._json({"erreur": str(e)[:200]}, 500)


