def generer_copyright(licence_key, auteur, annee=None, projet=None, email=None, url=None):
"""Genere un copyright personnalise."""
if annee is None:
annee = datetime.datetime.now().year

if licence_key not in LICENCES_PREDEFINIES:
return {"erreur": "Licence inconnue : " + licence_key}

licence = LICENCES_PREDEFINIES[licence_key]
contenu = licence["template"].format(annee=annee, auteur=auteur)

# Ajout de metadonnees
if projet:
contenu = "// Projet : " + projet + "\n" + contenu
if email:
contenu = "// Contact : " + email + "\n" + contenu
if url:
contenu = "// URL : " + url + "\n" + contenu

return {
"licence": licence["nom"],
"spdx": licence["spdx"],
"auteur": auteur,
"annee": annee,
"contenu": contenu,
"hash": hashlib.sha256(contenu.encode()).hexdigest(),
}


def generer_header_fichier(auteur, annee, projet, licence, email=None):
"""Genere un header a coller en haut de chaque fichier."""
header = "#!/usr/bin/env python3\n"
header += "# -*- coding: utf-8 -*-\n"
header += "# {}\n".format(projet or "Projet")
header += "# Copyright (c) {} {}\n".format(annee, auteur)
header += "# Licence : {}\n".format(licence)
if email:
header += "# Contact : {}\n".format(email)
header += "#\n"
header += "# Ce fichier fait partie du projet {}.\n".format(projet or "NEXUS")
header += "# Toute redistribution doit conserver cette mention.\n"
return header


def verifier_paternite(nom, api_key=None):
"""Verifie la paternite d'un nom via plusieurs APIs."""
resultats = {
"nom": nom,
"timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"sources": [],
}

# GitHub
try:
url = "https://api.github.com/search/users?q=" + urllib.parse.quote(nom)
req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
with urllib.request.urlopen(req, timeout=10, context=CTX) as r:
data = json.loads(r.read().decode("utf-8", "ignore"))
resultats["sources"].append({
"source": "github",
"total": data.get("total_count", 0),
"trouve": data.get("total_count", 0) > 0,
})
except Exception as e:
resultats["sources"].append({"source": "github", "erreur": str(e)[:80]})

# ORCID
try:
url = "https://pub.orcid.org/v3.0/expanded-search/?q=" + urllib.parse.quote(nom)
req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
with urllib.request.urlopen(req, timeout=10, context=CTX) as r:
data = json.loads(r.read().decode("utf-8", "ignore"))
resultats["sources"].append({
"source": "orcid",
"total": data.get("num-found", 0),
"trouve": data.get("num-found", 0) > 0,
})
except Exception as e:
resultats["sources"].append({"source": "orcid", "erreur": str(e)[:80]})

# OpenAlex
try:
url = "https://api.openalex.org/authors?search=" + urllib.parse.quote(nom)
req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
with urllib.request.urlopen(req, timeout=10, context=CTX) as r:
data = json.loads(r.read().decode("utf-8", "ignore"))
resultats["sources"].append({
"source": "openalex",
"total": data.get("meta", {}).get("count", 0),
"trouve": data.get("meta", {}).get("count", 0) > 0,
})
except Exception as e:
resultats["sources"].append({"source": "openalex", "erreur": str(e)[:80]})

return resultats


def rechercher_marque(nom):
"""Recherche un nom dans les registres de marques (USPTO)."""
try:
url = "https://developer.uspto.gov/ibd-api/v1/application/publications?searchText=" + urllib.parse.quote(nom)
req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
with urllib.request.urlopen(req, timeout=10, context=CTX) as r:
data = json.loads(r.read().decode("utf-8", "ignore"))
return {"trouve": True, "total": len(data.get("results", []))}
except Exception as e:
return {"trouve": False, "erreur": str(e)[:80]}


